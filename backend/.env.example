APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=space_crm
DB_USERNAME=space_crm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CRM_ADMIN_EMAIL=admin@space.test
CRM_ADMIN_PASSWORD=

# Phase 3 CMS gateway: keep disabled until schema, binding and staff access are reviewed.
CMS_GATEWAY_ENABLED=false
CMS_ERP_EXHIBITION_ID=
CMS_GATEWAY_KEY_ID=primary
CMS_GATEWAY_KEY=
GREEN_LIFE_PUBLIC_ORIGIN=
GREEN_LIFE_CMS_GATEWAY_URL=

# Phase 4: default off; reviewed event binding and independent backend-only key required.
INTAKE_ENABLED=false
INTAKE_EXHIBITION_ID=
INTAKE_SERVICE_KEY=
INTAKE_KEY_ID=primary
INTAKE_PEER_URL=
INTAKE_PRIVACY_VERSION=
INTAKE_RETENTION_DAYS=

# Phase 6.1: independently approved, disabled by default. Keep all secrets server-side.
PARTICIPANT_ONBOARDING_ENABLED=false
PARTICIPANT_ONBOARDING_TEST_INVITES=false
PARTICIPANT_ONBOARDING_SANDBOX=false
PARTICIPANT_ONBOARDING_LIVE_MAIL_AUTHORIZED=false
PARTICIPANT_ONBOARDING_SENDER_APPROVED=false
PARTICIPANT_ONBOARDING_TRACKING_DISABLED_APPROVED=false
PARTICIPANT_ONBOARDING_SENDER_DOMAIN=
PARTICIPANT_ONBOARDING_FROM_ADDRESS=
PARTICIPANT_ONBOARDING_FROM_NAME=
PARTICIPANT_ONBOARDING_WEBSITE_ORIGIN=
PARTICIPANT_ONBOARDING_KEY_ID=primary
PARTICIPANT_ONBOARDING_DELIVERY_KEY=
PARTICIPANT_ONBOARDING_PREVIOUS_DELIVERY_KEY=
PARTICIPANT_ONBOARDING_SMTP_SCHEME=smtps
PARTICIPANT_ONBOARDING_SMTP_HOST=
PARTICIPANT_ONBOARDING_SMTP_PORT=465
PARTICIPANT_ONBOARDING_SMTP_USERNAME=
PARTICIPANT_ONBOARDING_SMTP_PASSWORD=
PARTICIPANT_ONBOARDING_MAILER=participant_onboarding
PARTICIPANT_ONBOARDING_EXPIRY_HOURS=24
PARTICIPANT_ONBOARDING_LOCALE=en
PARTICIPANT_ONBOARDING_SUPPORT_EMAIL=
